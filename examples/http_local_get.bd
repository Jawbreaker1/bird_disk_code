import std::http.
import std::io.
import std::string.

rule main() -> i64:
  set req: string = std::http::build_request("GET", "http://example.com/hello", "").
  set req_line_ok: bool = std::string::contains(req, "GET /hello HTTP/1.1").
  set req_host_ok: bool = std::string::contains(req, "Host: example.com").

  set cr_bytes: u8[] = array(1).
  set cr_code: u8 = 13.
  put cr_bytes[0] = cr_code.
  set cr: string = std::string::from_bytes(cr_bytes).
  set eol: string = std::string::concat(cr, "\n").
  set p0: string = std::string::concat("HTTP/1.1 200 OK", eol).
  set p1: string = std::string::concat("Content-Length: 11", eol).
  set p2: string = std::string::concat("X-Demo: local", eol).
  set p3: string = std::string::concat(eol, "hello world").
  set response: string = std::string::concat(std::string::concat(p0, p1), std::string::concat(p2, p3)).

  set status: i64 = std::http::status(response).
  set headers: string = std::http::headers(response).
  set body: string = std::http::body(response).

  std::io::print(std::string::concat("http status: ", std::string::from_i64(status))).
  std::io::print("\n").
  std::io::print(std::string::concat("http body: ", body)).
  std::io::print("\n").

  when req_line_ok && req_host_ok && status == 200 && std::string::contains(headers, "X-Demo: local") && std::string::eq(body, "hello world"):
    yield 1.
  otherwise:
    yield -1.
  end
end
