import std::http.
import std::io.
import std::net.
import std::string.
import std::thread.
import std::time.

rule server(port: i64) -> i64:
  set addr: string = std::string::concat("127.0.0.1:", std::string::from_i64(port)).
  set listener: TcpListener = std::net::listen(addr).
  set stream: TcpStream = std::net::accept(listener).
  set req: string = std::net::read_line(stream).

  set reading_headers: bool = true.
  repeat while reading_headers:
    set line: string = std::net::read_line(stream).
    when std::string::len(line) == 0:
      put reading_headers = false.
    otherwise:
      set sink: i64 = std::string::len(line).
    end
  end

  set ignored: i64 = std::net::write_text(stream, "HTTP/1.1 200 OK\n").
  put ignored = std::net::write_text(stream, "Content-Length: 11\n").
  put ignored = std::net::write_text(stream, "X-Demo: local\n").
  put ignored = std::net::write_text(stream, "\n").
  put ignored = std::net::write_text(stream, "hello world").
  std::net::close_stream(stream).
  std::net::close_listener(listener).

  when std::string::eq(req, "GET /hello HTTP/1.1"):
    yield 1.
  otherwise:
    yield -1.
  end
end

rule main() -> i64:
  set port: i64 = 18082.
  set t: Thread = std::thread::spawn("server", port).
  set ignored: i64 = std::time::sleep_ms(30).

  set url0: string = std::string::concat("http://127.0.0.1:", std::string::from_i64(port)).
  set url: string = std::string::concat(url0, "/hello").
  set response: string = std::http::get(url).
  set status: i64 = std::http::status(response).
  set headers: string = std::http::headers(response).
  set body: string = std::http::body(response).
  set done: i64 = std::thread::join(t).

  std::io::print(std::string::concat("http status: ", std::string::from_i64(status))).
  std::io::print("\n").
  std::io::print(std::string::concat("http body: ", body)).
  std::io::print("\n").

  when done == 1 && status == 200 && std::string::contains(headers, "X-Demo: local") && std::string::eq(body, "hello world"):
    yield 1.
  otherwise:
    yield -1.
  end
end
