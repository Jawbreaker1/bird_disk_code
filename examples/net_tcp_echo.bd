import std::io.
import std::net.
import std::string.
import std::time.

rule main() -> i64:
  set port: i64 = 40000 + (std::time::now_ms() % 20000).
  set addr: string = std::string::concat("127.0.0.1:", std::string::from_i64(port)).
  set listener: TcpListener = std::net::listen(addr).

  set client: TcpStream = std::net::connect(addr).
  set server: TcpStream = std::net::accept(listener).
  set c_to: i64 = std::net::set_read_timeout_ms(client, 3000).
  set s_to: i64 = std::net::set_read_timeout_ms(server, 3000).

  set c_sent: i64 = std::net::write_text(client, "ping\n").
  set s_line: string = std::net::read_line(server).
  set s_sent: i64 = std::net::write_text(server, "pong\n").
  set c_line: string = std::net::read_line(client).

  std::net::close_stream(client).
  std::net::close_stream(server).
  std::net::close_listener(listener).

  std::io::print(std::string::concat("tcp reply: ", c_line)).
  std::io::print("\n").

  when c_sent > 0 && s_sent > 0 && std::string::eq(s_line, "ping") && std::string::eq(c_line, "pong"):
    yield 1.
  otherwise:
    yield -1.
  end
end
