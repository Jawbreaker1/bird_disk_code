import std::io.
import std::net.
import std::string.
import std::thread.
import std::web.
import std::webconfig.
import std::webfiles.

rule serve_static_route_stream(stream: TcpStream, route: i64) -> i64:
  set status: i64 = 200.
  set reason: string = "OK".
  set content_type: string = "text/html; charset=utf-8".
  set file_name: string = std::web::route_file_from_code(route).

  when std::string::len(file_name) == 0:
    put status = 404.
    put reason = "Not Found".
    put file_name = "404.html".
  otherwise:
    put content_type = std::web::content_type_for_file(file_name).
  end

  set body: string = "".
  try:
    put body = std::webfiles::read_public_file(file_name).
  catch read_error:
    put status = 500.
    put reason = "Internal Server Error".
    put content_type = "text/plain; charset=utf-8".
    put body = "failed to read asset\n".
  end

  set response: string = std::web::build_response(status, reason, content_type, body).
  set wrote: i64 = -1.
  try:
    put wrote = std::net::write_text(stream, response).
  catch write_error:
    put wrote = -1.
  end
  try:
    std::net::close_stream(stream).
  catch close_error:
    set ignore_close: i64 = 0.
  end

  when wrote > 0:
    yield 1.
  otherwise:
    yield -1.
  end
end

rule serve_request_inline(stream: TcpStream, method: string, path: string, served: i64) -> i64:
  set status: i64 = 200.
  set reason: string = "OK".
  set content_type: string = "text/html; charset=utf-8".
  set body: string = "".
  set shutdown_requested: bool = false.

  when std::string::eq(method, "GET"):
    when std::string::eq(path, "/api/status"):
      set served_text: string = std::string::from_i64(served).
      put content_type = "application/json; charset=utf-8".
      put body = std::string::concat("{\"ok\":true,\"served\":", std::string::concat(served_text, "}")).
    otherwise:
      when std::string::eq(path, "/health"):
        put content_type = "text/plain; charset=utf-8".
        put body = "ok\n".
      otherwise:
        when std::string::eq(path, "/shutdown"):
          put content_type = "text/plain; charset=utf-8".
          put body = "shutting down\n".
          put shutdown_requested = true.
        otherwise:
          set file_name: string = std::web::route_file(path).
          when std::string::len(file_name) > 0:
            try:
              put content_type = std::web::content_type_for_file(file_name).
              put body = std::webfiles::read_public_file(file_name).
            catch read_error:
              put status = 500.
              put reason = "Internal Server Error".
              put content_type = "text/plain; charset=utf-8".
              put body = "failed to read asset\n".
            end
          otherwise:
            put status = 404.
            put reason = "Not Found".
            put content_type = "text/html; charset=utf-8".
            try:
              put body = std::webfiles::read_public_file("404.html").
            catch missing_error:
              put content_type = "text/plain; charset=utf-8".
              put body = "not found\n".
            end
          end
        end
      end
    end
  otherwise:
    put status = 405.
    put reason = "Method Not Allowed".
    put content_type = "text/plain; charset=utf-8".
    put body = "method not allowed\n".
  end

  set response: string = std::web::build_response(status, reason, content_type, body).
  set wrote: i64 = -1.
  try:
    put wrote = std::net::write_text(stream, response).
  catch write_error:
    put wrote = -1.
  end
  try:
    std::net::close_stream(stream).
  catch close_error:
    set ignore_close: i64 = 0.
  end

  when wrote <= 0:
    yield -1.
  otherwise:
    when shutdown_requested:
      yield 2.
    otherwise:
      yield 1.
    end
  end
end

rule main() -> i64:
  set cfg: string = std::webfiles::config_text().
  set host: string = std::webconfig::host(cfg).
  set port: i64 = std::webconfig::port(cfg).
  set max_requests: i64 = std::webconfig::max_requests(cfg).
  set mode: string = std::webconfig::mode(cfg).
  set workers: i64 = std::webconfig::workers(cfg).

  set threaded_mode: bool = std::string::eq(mode, "threaded").
  set worker_cap: i64 = 1.
  when threaded_mode:
    put worker_cap = workers.
  otherwise:
    put worker_cap = 1.
  end

  set addr: string = std::string::concat(std::string::concat(host, ":"), std::string::from_i64(port)).
  set listener: TcpListener = std::net::listen(addr).
  set listen_msg: string = std::string::concat("web server listening on http://", addr).
  std::io::print(listen_msg).
  std::io::print("\n").

  set served: i64 = 0.
  set running: bool = true.

  when threaded_mode:
    set pending_threads: Thread[] = array(worker_cap).
    set pending_paths: string[] = array(worker_cap).
    set queue_head: i64 = 0.
    set queue_tail: i64 = 0.
    set pending_count: i64 = 0.

    repeat while running:
      when pending_count >= worker_cap:
        set joined_path: string = pending_paths[queue_head].
        set joined_done: i64 = std::thread::join(pending_threads[queue_head]).
        put queue_head = (queue_head + 1) % worker_cap.
        put pending_count = pending_count - 1.
        when joined_done <= 0:
          std::io::print(std::string::concat("serve failed path: ", joined_path)).
          std::io::print("\n").
        otherwise:
          put served = served + 1.
          std::io::print(std::string::concat("served path: ", joined_path)).
          std::io::print("\n").
        end
      otherwise:
        set stream: TcpStream = std::net::accept(listener).
        set request_line_raw: string = std::net::read_line(stream).
        set request_line: string = std::web::trim_trailing_cr(request_line_raw).

        set reading: bool = true.
        repeat while reading:
          set line_raw: string = std::net::read_line(stream).
          set line: string = std::web::trim_trailing_cr(line_raw).
          when std::string::len(line) == 0:
            put reading = false.
          otherwise:
            put reading = true.
          end
        end

        set method: string = std::web::request_method(request_line).
        set path: string = std::web::route_path(request_line).
        set thread_candidate: bool = std::web::is_threaded_candidate(method, path).

        when thread_candidate:
          set route: i64 = std::web::route_code(path).
          set t: Thread = std::thread::spawn("serve_static_route_stream", stream, route).
          put pending_threads[queue_tail] = t.
          put pending_paths[queue_tail] = path.
          put queue_tail = (queue_tail + 1) % worker_cap.
          put pending_count = pending_count + 1.
        otherwise:
          set outcome: i64 = serve_request_inline(stream, method, path, served).
          when outcome <= 0:
            std::io::print(std::string::concat("serve failed path: ", path)).
            std::io::print("\n").
          otherwise:
            put served = served + 1.
            std::io::print(std::string::concat("served path: ", path)).
            std::io::print("\n").
            set keep_after_outcome: bool = running && outcome != 2.
            put running = keep_after_outcome.
          end
        end
      end

      set keep_after_limit_threaded: bool = running && served < max_requests.
      put running = keep_after_limit_threaded.
    end

    repeat while pending_count > 0:
      set drained_path: string = pending_paths[queue_head].
      set drained_done: i64 = std::thread::join(pending_threads[queue_head]).
      put queue_head = (queue_head + 1) % worker_cap.
      put pending_count = pending_count - 1.
      when drained_done <= 0:
        std::io::print(std::string::concat("serve failed path: ", drained_path)).
        std::io::print("\n").
      otherwise:
        put served = served + 1.
        std::io::print(std::string::concat("served path: ", drained_path)).
        std::io::print("\n").
      end
    end
  otherwise:
    repeat while running:
      set stream_single: TcpStream = std::net::accept(listener).
      set request_line_single_raw: string = std::net::read_line(stream_single).
      set request_line_single: string = std::web::trim_trailing_cr(request_line_single_raw).

      set reading_single: bool = true.
      repeat while reading_single:
        set line_single_raw: string = std::net::read_line(stream_single).
        set line_single: string = std::web::trim_trailing_cr(line_single_raw).
        when std::string::len(line_single) == 0:
          put reading_single = false.
        otherwise:
          put reading_single = true.
        end
      end

      set method_single: string = std::web::request_method(request_line_single).
      set path_single: string = std::web::route_path(request_line_single).
      set outcome_single: i64 = serve_request_inline(stream_single, method_single, path_single, served).
      when outcome_single <= 0:
        std::io::print(std::string::concat("serve failed path: ", path_single)).
        std::io::print("\n").
      otherwise:
        put served = served + 1.
        std::io::print(std::string::concat("served path: ", path_single)).
        std::io::print("\n").
        set keep_after_outcome_single: bool = running && outcome_single != 2.
        put running = keep_after_outcome_single.
      end

      set keep_after_limit_single: bool = running && served < max_requests.
      put running = keep_after_limit_single.
    end
  end

  std::net::close_listener(listener).
  std::io::print(std::string::concat("served total: ", std::string::from_i64(served))).
  std::io::print("\n").
  yield served.
end
