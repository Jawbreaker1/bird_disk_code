import std::env.
import std::fs.
import std::io.
import std::net.
import std::string.
import std::thread.

rule build_response(
  status_code: i64,
  reason: string,
  content_type: string,
  body: string,
  eol: string
) -> string:
  set status0: string = std::string::concat("HTTP/1.1 ", std::string::from_i64(status_code)).
  set status1: string = std::string::concat(status0, " ").
  set status_line: string = std::string::concat(status1, reason).
  set head0: string = std::string::concat(status_line, eol).
  set head1: string = std::string::concat("Content-Type: ", content_type).
  set head2: string = std::string::concat(head1, eol).
  set len0: string = std::string::concat("Content-Length: ", std::string::from_i64(std::string::len(body))).
  set head3: string = std::string::concat(len0, eol).
  set head: string = std::string::concat(std::string::concat(head0, head2), std::string::concat(head3, eol)).
  yield std::string::concat(head, body).
end

rule http_eol() -> string:
  set cr_bytes: u8[] = array(1).
  put cr_bytes[0] = 13.
  set cr: string = std::string::from_bytes(cr_bytes).
  yield std::string::concat(cr, "\n").
end

rule route_path(request_line: string) -> string:
  set s0: i64 = std::string::index_of(request_line, " ").
  when s0 == -1:
    yield "/".
  otherwise:
    set start: i64 = s0 + 1.
    set tail: string = std::string::slice(request_line, start, std::string::len(request_line) - start).
    set s1: i64 = std::string::index_of(tail, " ").
    when s1 == -1:
      yield "/".
    otherwise:
      yield std::string::slice(tail, 0, s1).
    end
  end
end

rule request_method(request_line: string) -> string:
  set s0: i64 = std::string::index_of(request_line, " ").
  when s0 == -1:
    yield "GET".
  otherwise:
    yield std::string::slice(request_line, 0, s0).
  end
end

rule trim_trailing_cr(line: string) -> string:
  set n: i64 = std::string::len(line).
  set cr_bytes: u8[] = array(1).
  put cr_bytes[0] = 13.
  set cr: string = std::string::from_bytes(cr_bytes).
  when n <= 0:
    yield line.
  otherwise:
    set last: string = std::string::slice(line, n - 1, 1).
    when std::string::eq(last, cr):
      yield std::string::slice(line, 0, n - 1).
    otherwise:
      yield line.
    end
  end
end

rule example_root() -> string:
  set cwd: string = std::env::cwd().
  when std::string::contains(cwd, "/examples/web_server_simple"):
    yield "".
  otherwise:
    when std::string::contains(cwd, "/examples"):
      yield "web_server_simple/".
    otherwise:
      yield "examples/web_server_simple/".
    end
  end
end

rule public_root() -> string:
  yield std::string::concat(example_root(), "public/").
end

rule config_text() -> string:
  set path: string = std::string::concat(example_root(), "web_server_simple.conf").
  yield std::fs::read_text(path).
end

rule config_value(text: string, key: string) -> string:
  set needle: string = std::string::concat(key, " ").
  set idx: i64 = std::string::index_of(text, needle).
  when idx == -1:
    throw std::string::concat("Missing config key: ", key).
  otherwise:
    set value_start: i64 = idx + std::string::len(needle).
    set tail: string = std::string::slice(text, value_start, std::string::len(text) - value_start).
    set line_end: i64 = std::string::index_of(tail, "\n").
    set line: string = "".
    when line_end == -1:
      put line = tail.
    otherwise:
      put line = std::string::slice(tail, 0, line_end).
    end
    yield trim_trailing_cr(line).
  end
end

rule config_value_or(text: string, key: string, fallback: string) -> string:
  set needle: string = std::string::concat(key, " ").
  set idx: i64 = std::string::index_of(text, needle).
  when idx == -1:
    yield fallback.
  otherwise:
    set value_start: i64 = idx + std::string::len(needle).
    set tail: string = std::string::slice(text, value_start, std::string::len(text) - value_start).
    set line_end: i64 = std::string::index_of(tail, "\n").
    set line: string = "".
    when line_end == -1:
      put line = tail.
    otherwise:
      put line = std::string::slice(tail, 0, line_end).
    end
    yield trim_trailing_cr(line).
  end
end

rule config_host(text: string) -> string:
  yield config_value(text, "host").
end

rule config_port(text: string) -> i64:
  set port_text: string = config_value(text, "port").
  yield std::string::to_i64(port_text).
end

rule config_max_requests(text: string) -> i64:
  set raw: string = config_value(text, "max_requests").
  yield std::string::to_i64(raw).
end

rule config_mode(text: string) -> string:
  set mode: string = config_value_or(text, "mode", "single").
  when std::string::eq(mode, "single") || std::string::eq(mode, "threaded"):
    yield mode.
  otherwise:
    throw std::string::concat("Invalid mode: ", mode).
  end
end

rule config_workers(text: string) -> i64:
  set raw: string = config_value_or(text, "workers", "4").
  set value: i64 = std::string::to_i64(raw).
  when value > 0:
    yield value.
  otherwise:
    throw "Invalid workers: must be > 0".
  end
end

rule route_file(path: string) -> string:
  when std::string::eq(path, "/"):
    yield "index.html".
  otherwise:
    when std::string::eq(path, "/hello"):
      yield "index.html".
    otherwise:
      when std::string::eq(path, "/features"):
        yield "features.html".
      otherwise:
        when std::string::eq(path, "/about"):
          yield "about.html".
        otherwise:
          when std::string::eq(path, "/style.css"):
            yield "style.css".
          otherwise:
            when std::string::eq(path, "/app.js"):
              yield "app.js".
            otherwise:
              yield "".
            end
          end
        end
      end
    end
  end
end

rule route_code(path: string) -> i64:
  when std::string::eq(path, "/") || std::string::eq(path, "/hello"):
    yield 1.
  otherwise:
    when std::string::eq(path, "/features"):
      yield 2.
    otherwise:
      when std::string::eq(path, "/about"):
        yield 3.
      otherwise:
        when std::string::eq(path, "/style.css"):
          yield 4.
        otherwise:
          when std::string::eq(path, "/app.js"):
            yield 5.
          otherwise:
            yield 0.
          end
        end
      end
    end
  end
end

rule content_type_for_file(file_name: string) -> string:
  when std::string::eq(file_name, "style.css"):
    yield "text/css; charset=utf-8".
  otherwise:
    when std::string::eq(file_name, "app.js"):
      yield "text/javascript; charset=utf-8".
    otherwise:
      yield "text/html; charset=utf-8".
    end
  end
end

rule read_public_file(file_name: string) -> string:
  set base: string = public_root().
  set full: string = std::string::concat(base, file_name).
  yield std::fs::read_text(full).
end

rule is_threaded_candidate(method: string, path: string) -> bool:
  when !std::string::eq(method, "GET"):
    yield false.
  otherwise:
    when std::string::eq(path, "/api/status") || std::string::eq(path, "/health") || std::string::eq(path, "/shutdown"):
      yield false.
    otherwise:
      yield true.
    end
  end
end

rule serve_static_route_stream(stream: TcpStream, route: i64) -> i64:
  set status: i64 = 200.
  set reason: string = "OK".
  set content_type: string = "text/html; charset=utf-8".
  set file_name: string = "index.html".

  when route == 1:
    put file_name = "index.html".
  otherwise:
    when route == 2:
      put file_name = "features.html".
    otherwise:
      when route == 3:
        put file_name = "about.html".
      otherwise:
        when route == 4:
          put file_name = "style.css".
        otherwise:
          when route == 5:
            put file_name = "app.js".
          otherwise:
            put status = 404.
            put reason = "Not Found".
            put file_name = "404.html".
          end
        end
      end
    end
  end

  set body: string = "".
  try:
    put content_type = content_type_for_file(file_name).
    put body = read_public_file(file_name).
  catch read_error:
    put status = 500.
    put reason = "Internal Server Error".
    put content_type = "text/plain; charset=utf-8".
    put body = "failed to read asset\n".
  end

  set response: string = build_response(status, reason, content_type, body, http_eol()).
  set wrote: i64 = std::net::write_text(stream, response).
  std::net::close_stream(stream).

  when wrote > 0:
    yield 1.
  otherwise:
    yield -1.
  end
end

rule serve_request_inline(stream: TcpStream, method: string, path: string, served: i64) -> i64:
  set status: i64 = 200.
  set reason: string = "OK".
  set content_type: string = "text/html; charset=utf-8".
  set body: string = "".
  set shutdown_requested: bool = false.

  when std::string::eq(method, "GET"):
    when std::string::eq(path, "/api/status"):
      set served_text: string = std::string::from_i64(served).
      put content_type = "application/json; charset=utf-8".
      put body = std::string::concat("{\"ok\":true,\"served\":", std::string::concat(served_text, "}")).
    otherwise:
      when std::string::eq(path, "/health"):
        put content_type = "text/plain; charset=utf-8".
        put body = "ok\n".
      otherwise:
        when std::string::eq(path, "/shutdown"):
          put content_type = "text/plain; charset=utf-8".
          put body = "shutting down\n".
          put shutdown_requested = true.
        otherwise:
          set file_name: string = route_file(path).
          when std::string::len(file_name) > 0:
            try:
              put content_type = content_type_for_file(file_name).
              put body = read_public_file(file_name).
            catch read_error:
              put status = 500.
              put reason = "Internal Server Error".
              put content_type = "text/plain; charset=utf-8".
              put body = "failed to read asset\n".
            end
          otherwise:
            put status = 404.
            put reason = "Not Found".
            put content_type = "text/html; charset=utf-8".
            try:
              put body = read_public_file("404.html").
            catch missing_error:
              put content_type = "text/plain; charset=utf-8".
              put body = "not found\n".
            end
          end
        end
      end
    end
  otherwise:
    put status = 405.
    put reason = "Method Not Allowed".
    put content_type = "text/plain; charset=utf-8".
    put body = "method not allowed\n".
  end

  set response: string = build_response(status, reason, content_type, body, http_eol()).
  set wrote: i64 = std::net::write_text(stream, response).
  std::net::close_stream(stream).

  when wrote <= 0:
    yield -1.
  otherwise:
    when shutdown_requested:
      yield 2.
    otherwise:
      yield 1.
    end
  end
end

rule main() -> i64:
  set cfg: string = config_text().
  set host: string = config_host(cfg).
  set port: i64 = config_port(cfg).
  set max_requests: i64 = config_max_requests(cfg).
  set mode: string = config_mode(cfg).
  set workers: i64 = config_workers(cfg).

  set threaded_mode: bool = std::string::eq(mode, "threaded").
  set worker_cap: i64 = 1.
  when threaded_mode:
    put worker_cap = workers.
  otherwise:
    put worker_cap = 1.
  end

  set addr: string = std::string::concat(std::string::concat(host, ":"), std::string::from_i64(port)).
  set listener: TcpListener = std::net::listen(addr).
  set listen_msg: string = std::string::concat("web server listening on http://", addr).
  std::io::print(listen_msg).
  std::io::print("\n").

  set served: i64 = 0.
  set running: bool = true.
  set failed: bool = false.

  when threaded_mode:
    set pending_threads: Thread[] = array(worker_cap).
    set pending_paths: string[] = array(worker_cap).
    set queue_head: i64 = 0.
    set queue_tail: i64 = 0.
    set pending_count: i64 = 0.

    repeat while running:
      when pending_count >= worker_cap:
        set joined_path: string = pending_paths[queue_head].
        set joined_done: i64 = std::thread::join(pending_threads[queue_head]).
        put queue_head = (queue_head + 1) % worker_cap.
        put pending_count = pending_count - 1.
        when joined_done <= 0:
          put failed = true.
          put running = false.
        otherwise:
          put served = served + 1.
          std::io::print(std::string::concat("served path: ", joined_path)).
          std::io::print("\n").
        end
      otherwise:
        set stream: TcpStream = std::net::accept(listener).
        set request_line: string = std::net::read_line(stream).

        set reading: bool = true.
        repeat while reading:
          set line: string = std::net::read_line(stream).
          when std::string::len(line) == 0:
            put reading = false.
          otherwise:
            put reading = true.
          end
        end

        set method: string = request_method(request_line).
        set path: string = route_path(request_line).
        set thread_candidate: bool = is_threaded_candidate(method, path).

        when thread_candidate:
          set route: i64 = route_code(path).
          set t: Thread = std::thread::spawn("serve_static_route_stream", stream, route).
          put pending_threads[queue_tail] = t.
          put pending_paths[queue_tail] = path.
          put queue_tail = (queue_tail + 1) % worker_cap.
          put pending_count = pending_count + 1.
        otherwise:
          set outcome: i64 = serve_request_inline(stream, method, path, served).
          when outcome <= 0:
            put failed = true.
            put running = false.
          otherwise:
            put served = served + 1.
            std::io::print(std::string::concat("served path: ", path)).
            std::io::print("\n").
            set keep_after_outcome: bool = running && outcome != 2.
            put running = keep_after_outcome.
          end
        end
      end

      set keep_after_limit_threaded: bool = running && served < max_requests.
      put running = keep_after_limit_threaded.
    end

    repeat while pending_count > 0:
      set drained_path: string = pending_paths[queue_head].
      set drained_done: i64 = std::thread::join(pending_threads[queue_head]).
      put queue_head = (queue_head + 1) % worker_cap.
      put pending_count = pending_count - 1.
      when drained_done <= 0:
        put failed = true.
      otherwise:
        put served = served + 1.
        std::io::print(std::string::concat("served path: ", drained_path)).
        std::io::print("\n").
      end
    end
  otherwise:
    repeat while running:
      set stream_single: TcpStream = std::net::accept(listener).
      set request_line_single: string = std::net::read_line(stream_single).

      set reading_single: bool = true.
      repeat while reading_single:
        set line_single: string = std::net::read_line(stream_single).
        when std::string::len(line_single) == 0:
          put reading_single = false.
        otherwise:
          put reading_single = true.
        end
      end

      set method_single: string = request_method(request_line_single).
      set path_single: string = route_path(request_line_single).
      set outcome_single: i64 = serve_request_inline(stream_single, method_single, path_single, served).
      when outcome_single <= 0:
        put failed = true.
        put running = false.
      otherwise:
        put served = served + 1.
        std::io::print(std::string::concat("served path: ", path_single)).
        std::io::print("\n").
        set keep_after_outcome_single: bool = running && outcome_single != 2.
        put running = keep_after_outcome_single.
      end

      set keep_after_limit_single: bool = running && served < max_requests.
      put running = keep_after_limit_single.
    end
  end

  std::net::close_listener(listener).
  std::io::print(std::string::concat("served total: ", std::string::from_i64(served))).
  std::io::print("\n").

  when failed:
    yield -1.
  otherwise:
    yield served.
  end
end
