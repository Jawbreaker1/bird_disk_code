import std::string.

rule trim_trailing_cr(line: string) -> string:
  set n: i64 = std::string::len(line).
  set cr_bytes: u8[] = array(1).
  put cr_bytes[0] = 13.
  set cr: string = std::string::from_bytes(cr_bytes).
  when n <= 0:
    yield line.
  otherwise:
    set last: string = std::string::slice(line, n - 1, 1).
    when std::string::eq(last, cr):
      yield std::string::slice(line, 0, n - 1).
    otherwise:
      yield line.
    end
  end
end

rule crlf() -> string:
  set cr_bytes: u8[] = array(1).
  put cr_bytes[0] = 13.
  set cr: string = std::string::from_bytes(cr_bytes).
  yield std::string::concat(cr, "\n").
end

rule build_response(
  status_code: i64,
  reason: string,
  content_type: string,
  body: string
) -> string:
  set eol: string = crlf().
  set status0: string = std::string::concat("HTTP/1.1 ", std::string::from_i64(status_code)).
  set status1: string = std::string::concat(status0, " ").
  set status_line: string = std::string::concat(status1, reason).
  set head0: string = std::string::concat(status_line, eol).
  set head1: string = std::string::concat("Content-Type: ", content_type).
  set head2: string = std::string::concat(head1, eol).
  set len0: string = std::string::concat("Content-Length: ", std::string::from_i64(std::string::len(body))).
  set head3: string = std::string::concat(len0, eol).
  set head: string = std::string::concat(std::string::concat(head0, head2), std::string::concat(head3, eol)).
  yield std::string::concat(head, body).
end

rule request_method(request_line: string) -> string:
  set s0: i64 = std::string::index_of(request_line, " ").
  when s0 == -1:
    yield "GET".
  otherwise:
    yield std::string::slice(request_line, 0, s0).
  end
end

rule canonical_path(path: string) -> string:
  set out: string = path.
  set q: i64 = std::string::index_of(out, "?").
  when q != -1:
    put out = std::string::slice(out, 0, q).
  otherwise:
    put out = out.
  end

  set h: i64 = std::string::index_of(out, "#").
  when h != -1:
    put out = std::string::slice(out, 0, h).
  otherwise:
    put out = out.
  end

  when std::string::len(out) == 0:
    yield "/".
  otherwise:
    set n: i64 = std::string::len(out).
    when n > 1:
      set last: string = std::string::slice(out, n - 1, 1).
      when std::string::eq(last, "/"):
        yield std::string::slice(out, 0, n - 1).
      otherwise:
        yield out.
      end
    otherwise:
      yield out.
    end
  end
end

rule route_path(request_line: string) -> string:
  set s0: i64 = std::string::index_of(request_line, " ").
  when s0 == -1:
    yield "/".
  otherwise:
    set start: i64 = s0 + 1.
    set tail: string = std::string::slice(request_line, start, std::string::len(request_line) - start).
    set s1: i64 = std::string::index_of(tail, " ").
    set raw_path: string = "".
    when s1 == -1:
      put raw_path = tail.
    otherwise:
      put raw_path = std::string::slice(tail, 0, s1).
    end
    yield canonical_path(raw_path).
  end
end

rule route_file(path: string) -> string:
  set normalized: string = canonical_path(path).
  when std::string::eq(normalized, "/") || std::string::eq(normalized, "/hello"):
    yield "index.html".
  otherwise:
    when std::string::eq(normalized, "/features"):
      yield "features.html".
    otherwise:
      when std::string::eq(normalized, "/about"):
        yield "about.html".
      otherwise:
        when std::string::eq(normalized, "/style.css"):
          yield "style.css".
        otherwise:
          when std::string::eq(normalized, "/app.js"):
            yield "app.js".
          otherwise:
            yield "".
          end
        end
      end
    end
  end
end

rule route_code(path: string) -> i64:
  set normalized: string = canonical_path(path).
  when std::string::eq(normalized, "/") || std::string::eq(normalized, "/hello"):
    yield 1.
  otherwise:
    when std::string::eq(normalized, "/features"):
      yield 2.
    otherwise:
      when std::string::eq(normalized, "/about"):
        yield 3.
      otherwise:
        when std::string::eq(normalized, "/style.css"):
          yield 4.
        otherwise:
          when std::string::eq(normalized, "/app.js"):
            yield 5.
          otherwise:
            yield 0.
          end
        end
      end
    end
  end
end

rule route_file_from_code(code: i64) -> string:
  when code == 1:
    yield "index.html".
  otherwise:
    when code == 2:
      yield "features.html".
    otherwise:
      when code == 3:
        yield "about.html".
      otherwise:
        when code == 4:
          yield "style.css".
        otherwise:
          when code == 5:
            yield "app.js".
          otherwise:
            yield "".
          end
        end
      end
    end
  end
end

rule content_type_for_file(file_name: string) -> string:
  when std::string::eq(file_name, "style.css"):
    yield "text/css; charset=utf-8".
  otherwise:
    when std::string::eq(file_name, "app.js"):
      yield "text/javascript; charset=utf-8".
    otherwise:
      yield "text/html; charset=utf-8".
    end
  end
end

rule is_threaded_candidate(method: string, path: string) -> bool:
  set normalized: string = canonical_path(path).
  when !std::string::eq(method, "GET"):
    yield false.
  otherwise:
    when std::string::eq(normalized, "/api/status") || std::string::eq(normalized, "/health") || std::string::eq(normalized, "/shutdown"):
      yield false.
    otherwise:
      yield true.
    end
  end
end
