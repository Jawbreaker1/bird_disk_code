rule args() -> string[]:
  yield std::env::host_args().
end

rule get(name: string) -> string:
  yield std::env::host_get(name).
end

rule set_var(name: string, value: string) -> i64:
  yield std::env::host_set_var(name, value).
end

rule cwd() -> string:
  yield std::env::host_cwd().
end

rule set_cwd(path: string) -> i64:
  yield std::env::host_set_cwd(path).
end
